{
  "name": "kablet-core",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @kablet/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "tsx tests/e2e/orchestrate.ts",
    "db:migrate": "pnpm --filter @kablet/db db:migrate",
    "db:verify": "pnpm --filter @kablet/db db:verify",
    "worker": "pnpm --filter @kablet/worker start"
  },
  "devDependencies": {
    "@kablet/config": "workspace:*",
    "@kablet/db": "workspace:*",
    "@kablet/domain": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@eslint/js": "^9.39.5",
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "drizzle-orm": "^0.44.5",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.26",
    "pg": "^8.16.3",
    "typescript-eslint": "^8.42.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
