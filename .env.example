NODE_ENV=development
DATABASE_URL=postgresql://kablet_dev:<local-password>@localhost:5432/kablet_dev
# Used only when NODE_ENV=test; point this at an isolated disposable database.
TEST_DATABASE_URL=postgresql://kablet_test_manager:<local-password>@localhost:5432/kablet_test_<unique-id>
PORT=3000
NEXT_PUBLIC_APP_NAME=Kablet
TEST_MANAGER_HOST=localhost
TEST_MANAGER_PORT=5432
TEST_MANAGER_USER=kablet_test_manager
TEST_MANAGER_PASSWORD=<local-test-manager-password>
TEST_MANAGER_DATABASE=postgres
TEST_BOOTSTRAP_USER=<trusted-migration-bootstrap-role>
TEST_BOOTSTRAP_PASSWORD=<trusted-migration-bootstrap-password>
TEST_ROLE_ADMIN_URL=postgresql://<role-admin>:<password>@localhost:5432/postgres
